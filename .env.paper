# =============================================================================
# Aeternus Paper Trading Configuration
# Investment Firm Philosophy — NOT a prop shop
# =============================================================================
# Copy this file to .env and fill in your Alpaca credentials.
# Then run: aeternus execute-paper --execution-mode alpaca-paper

# -----------------------------------------------------------------------------
# Broker Configuration
# -----------------------------------------------------------------------------
EXECUTION_BROKER_MODE=alpaca-paper
APCA_API_KEY_ID=<your-alpaca-paper-api-key>
APCA_API_SECRET_KEY=<your-alpaca-paper-secret-key>
ALPACA_PAPER_API_BASE_URL=https://paper-api.alpaca.markets

# -----------------------------------------------------------------------------
# Capital & Scoring Thresholds
# -----------------------------------------------------------------------------
PORTFOLIO_CAPITAL_USD=100000
PORTFOLIO_MIN_SCORE=55
PORTFOLIO_MIN_CONFIDENCE=3
PORTFOLIO_MAX_POSITIONS=12

# -----------------------------------------------------------------------------
# Conviction-Weighted Concentration
# Buffett puts 40%+ in his top pick. If analysis says BUY with 5/5 conviction,
# size it accordingly. Concentration wins — nobody made asymmetric returns
# through diversification.
# -----------------------------------------------------------------------------
PORTFOLIO_MAX_WEIGHT_PER_POSITION=0.40
EXECUTION_MAX_SINGLE_POSITION_PCT=0.40
EXECUTION_MAX_GROSS_EXPOSURE_PCT=1.00
EXECUTION_MAX_OPEN_POSITIONS=12
EXECUTION_MAX_NEW_ORDERS_PER_RUN=6

# -----------------------------------------------------------------------------
# NO Arbitrary Stops — We Hedge, We Don't Panic Sell
#
# The hedging engine (Wyckoff phase overlay + VIX regime system) manages
# portfolio-level risk. Individual positions are held on thesis.
#
# Exits are driven by ANALYSIS, not percentages:
#   - THESIS_INVALIDATED: price crosses analyst-defined invalidation conditions
#   - CONVICTION_DECAY: conviction decays below 2.0 over time (exponential)
#   - SCORE_DETERIORATION: re-analysis shows score dropped significantly
#   - INDEX_OVERLAY_NO_SIGNAL: v3 VIX system removes market structure support
#   - REGIME_EXIT_SIGNAL: regime engine signals risk-off
# -----------------------------------------------------------------------------
EXECUTION_EXIT_STOP_LOSS_PCT=0.0
EXECUTION_EXIT_TAKE_PROFIT_PCT=0.0
EXECUTION_EXIT_TRAILING_STOP_PCT=0.0
EXECUTION_EXIT_MAX_HOLD_DAYS=0

# -----------------------------------------------------------------------------
# Hedging — Shorts Only Via Overlay, Never Direct
# The Wyckoff phase engine + VIX system short SPY/QQQ for portfolio protection.
# Direct short selling of individual names is blocked.
# -----------------------------------------------------------------------------
EXECUTION_ALLOW_HEDGE_SHORT_ORDERS=true
EXECUTION_BLOCK_SHORT_ORDERS=true

# -----------------------------------------------------------------------------
# Position Re-Analysis (S-051)
# Periodic re-analysis of open positions. When score drops, it's a thesis
# change signal. This replaces arbitrary take-profit/stop-loss.
# -----------------------------------------------------------------------------
REANALYSIS_MIN_HOLD_DAYS=5
REANALYSIS_EXIT_SCORE_THRESHOLD=40
REANALYSIS_EXIT_SCORE_DROP_PCT=0.30

# -----------------------------------------------------------------------------
# Reconciliation Daemon
# Run continuously to sync broker state and enforce exit rules.
# -----------------------------------------------------------------------------
RECONCILIATION_POLL_INTERVAL_SECONDS=60
RECONCILIATION_AUTO_EXIT_CHECK=true
RECONCILIATION_AUTO_REGIME_UPDATE=true

# -----------------------------------------------------------------------------
# Risk Circuit Breakers
# Hard limits that halt trading if breached — these are non-negotiable.
# -----------------------------------------------------------------------------
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_MAX_DRAWDOWN_PCT=0.15
RISK_MAX_SECTOR_PCT=0.40

# -----------------------------------------------------------------------------
# LLM Configuration (for API-mode analysis — session mode is free)
# -----------------------------------------------------------------------------
AETERNUS_LLM_PROVIDER=openai
AETERNUS_BACKEND_URL=https://opencode.ai/zen/v1
AETERNUS_QUICK_MODEL=minimax-m2.5
AETERNUS_DEEP_MODEL=minimax-m2.5

# -----------------------------------------------------------------------------
# Data Vendors
# Alpha Vantage free tier for fundamentals/news. Google for web news.
# -----------------------------------------------------------------------------
# ALPHA_VANTAGE_API_KEY=<your-key>

# -----------------------------------------------------------------------------
# Optional: Deal Flow Enrichment
# These are OFF by default to minimize API costs.
# Enable only after understanding the cost per call.
# -----------------------------------------------------------------------------
# XAI_API_KEY=<your-key>
# CASHTAG_ENRICHER_ENABLED=false
# AKG_PERPLEXITY_ENABLED=false
