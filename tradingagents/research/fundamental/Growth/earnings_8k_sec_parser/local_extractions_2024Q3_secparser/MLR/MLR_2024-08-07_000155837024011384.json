    {
      "type": "TableElement",
      "text": "​​​​CONTACT:Miller Industries, Inc.​​Debbie Whitmire, Chief Financial Officer(423) 238-8464​​​​​FTI Consulting, Inc.​​Mike Gaudreau millerind@fticonsulting.com"
    },
