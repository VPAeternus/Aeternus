# Aeternus Platform - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# LLM Provider API Keys
# ============================================

# OpenAI (default provider)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (alternative provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (alternative provider)
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter (Unified API provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# xAI Grok (Native API provider)
XAI_API_KEY=your_xai_api_key_here

# ============================================
# Data Provider API Keys
# ============================================

# Alpha Vantage (market data, fundamentals, news)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Finnhub (market data, insider transactions)
FINNHUB_API_KEY=your_finnhub_api_key_here

# X API (direct X ingestion for deal-flow)
X_API_BEARER_TOKEN=your_x_api_bearer_token_here

# SEC / Congress smart-money connectors
SEC_API_USER_AGENT="AeternusAgentsAG/1.0 (Your Org; your-email@example.com)"
DEALFLOW_SEC_MANAGER_CIKS=1067983,1350694,1029160,1603466
DEALFLOW_CONGRESS_SENATE_URL=https://raw.githubusercontent.com/timothycarambat/senate-stock-watcher-data/master/aggregate/all_transactions.json
# Max age of latest congress transaction in source before source is treated as stale
DEALFLOW_CONGRESS_MAX_STALENESS_DAYS=120

# Optional: attribution-driven X budget tuning
DEALFLOW_X_AUTO_TUNE_ENABLED=true
DEALFLOW_X_AUTO_TUNE_APPLY=true
DEALFLOW_X_TUNER_LOOKBACK_DAYS=30
DEALFLOW_X_TUNER_MIN_EVALUATED=6
DEALFLOW_X_TUNER_EDGE_UP_THRESHOLD=1.0
DEALFLOW_X_TUNER_EDGE_DOWN_THRESHOLD=-1.0
DEALFLOW_X_TUNER_WIN_RATE_UP=0.55
DEALFLOW_X_TUNER_WIN_RATE_DOWN=0.45
DEALFLOW_X_TUNER_MIN_CALLS=1
DEALFLOW_X_TUNER_MAX_CALLS=15
DEALFLOW_X_TUNER_MAX_STEP_CALLS=1
DEALFLOW_X_TUNER_MIN_DAILY_BUDGET_USD=8.0
DEALFLOW_X_TUNER_MAX_DAILY_BUDGET_USD=30.0
DEALFLOW_X_TUNER_REQUIRE_HORIZON_ALIGNMENT=true
DEALFLOW_X_TUNER_FAMILIES=cashtag_momentum,social_momentum,news_catalyst

# Optional: cap social/news connector workload for faster scheduled cycles
DEALFLOW_SOCIAL_MAX_SYMBOL_CALLS=35
DEALFLOW_SOCIAL_LOOKBACK_DAYS=7

# Optional: cashtag expansion and X discovery controls
DEALFLOW_X_EXPANSION_VELOCITY_Z=2.0
DEALFLOW_X_MAX_SYMBOL_EXPANSIONS=3
DEALFLOW_DYNAMIC_UNIVERSE_MAX_EXTRA_SYMBOLS=60
DEALFLOW_X_DISCOVERY_ENABLED=true
DEALFLOW_X_DISCOVERY_WEEKDAY=6
DEALFLOW_X_DISCOVERY_MAX_NEW_ACCOUNTS=25
DEALFLOW_X_DISCOVERY_MIN_QUALITY=55
DEALFLOW_X_DISCOVERY_MIN_POSTS=3

# Optional: manual watchlist overlay controls
DEALFLOW_MANUAL_WATCHLIST_PATH=eval_results/deal_flow/manual_watchlist.json
DEALFLOW_MANUAL_SLOTS_TARGET=3
DEALFLOW_MANUAL_SLOTS_MIN=2
DEALFLOW_MANUAL_SLOTS_MAX=4
DEALFLOW_MANUAL_MIN_ADV_USD=50000000
DEALFLOW_MANUAL_FORCE_INSERT=true
DEALFLOW_MANUAL_DEFAULT_TTL_DAYS=30

# Optional: Step 1 readiness gates (go/no-go for Step 2)
DEALFLOW_STEP1_LOOKBACK_DAYS=60
DEALFLOW_STEP1_REQUIRED_STABLE_CYCLES=3
DEALFLOW_STEP1_MIN_BATCH_EXECUTED_PER_CYCLE=1
DEALFLOW_STEP1_MAX_BATCH_FAILURE_RATIO=0.40
DEALFLOW_STEP1_MAX_CONNECTOR_ERRORS_PER_CYCLE=0
DEALFLOW_STEP1_MIN_EVALUATED_5D=2
DEALFLOW_STEP1_MIN_EVALUATED_20D=2
DEALFLOW_STEP1_TARGET_EVALUATED_5D=20
DEALFLOW_STEP1_TARGET_EVALUATED_20D=20
DEALFLOW_STEP1_REQUIRED_CONNECTORS=social_news,price_momentum,value_overlay,macro,smart_money
DEALFLOW_STEP1_OPTIONAL_CONNECTORS=
DEALFLOW_STEP1_REQUIRED_CONNECTOR_STATUSES=OK,NO_DATA

# ============================================
# Optional Configuration
# ============================================

# Results directory (default: ./results)
TRADINGAGENTS_RESULTS_DIR=./results

# LLM Provider Selection (options: openai, anthropic, google, ollama, openrouter)
# LLM_PROVIDER=openai

# Backend URL (for custom OpenAI-compatible endpoints)
# BACKEND_URL=https://api.openai.com/v1

# Deal-flow momentum lane calibration (optional)
# DEALFLOW_MOMENTUM_LANE_THRESHOLD=68.0
# DEALFLOW_MOMENTUM_LANE_MIN_CASHTAG_EVIDENCE=3
# DEALFLOW_MOMENTUM_LANE_PRICE_OVERRIDE_THRESHOLD=82.0
# DEALFLOW_MOMENTUM_LANE_SOCIAL_CONFIRMATION_THRESHOLD=60.0
# DEALFLOW_MOMENTUM_LANE_FLOOR_RATIO=0.20
# DEALFLOW_MOMENTUM_LANE_PROMOTION_MIN_SCORE=62.0
# DEALFLOW_MOMENTUM_LANE_PROMOTION_MIN_PRICE_SCORE=70.0

# xAI tool-search output bound (optional)
# XAI_TOOL_MAX_OUTPUT_TOKENS=900

# Step 2: portfolio construction + execution wiring (paper)
# PORTFOLIO_CAPITAL_USD=100000
# PORTFOLIO_MAX_POSITIONS=8
# PORTFOLIO_MIN_SCORE=55
# PORTFOLIO_MIN_CONFIDENCE=3
# PORTFOLIO_MAX_WEIGHT_PER_POSITION=0.25
# EXECUTION_BROKER_MODE=paper  # options: paper, live, alpaca-paper, alpaca-live
# APCA_API_KEY_ID=your_alpaca_key_id_here
# APCA_API_SECRET_KEY=your_alpaca_secret_key_here
# ALPACA_API_BASE_URL=
# ALPACA_PAPER_API_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_LIVE_API_BASE_URL=https://api.alpaca.markets
# ALPACA_REQUEST_TIMEOUT_SECONDS=15
# ALPACA_ENFORCE_WHOLE_SHARES=true
# PAPER_EXECUTION_SLIPPAGE_BPS=0.0
# PAPER_ORDERS_PATH=eval_results/paper_execution/orders.json
# LIVE_EXECUTION_OUTBOX_PATH=eval_results/live_execution/outbox.json
# LIVE_POSITIONS_SHADOW_PATH=eval_results/live_execution/positions_shadow.json
# LIVE_EXECUTION_FILLS_PATH=eval_results/live_execution/fills.json
# LIVE_EXECUTION_CLOSED_TRADES_PATH=eval_results/live_execution/closed_trades.json
# LIVE_BROKER_ORDERS_SNAPSHOT_PATH=eval_results/live_execution/broker_orders_latest.json
# LIVE_BROKER_POSITIONS_SNAPSHOT_PATH=eval_results/live_execution/broker_positions_latest.json
# EXECUTION_EXIT_STOP_LOSS_PCT=0.08
# EXECUTION_EXIT_TAKE_PROFIT_PCT=0.20
# EXECUTION_EXIT_MAX_HOLD_DAYS=20
# EXECUTION_EXIT_TRAILING_STOP_PCT=0.00
# EXECUTION_EXIT_MIN_POSITION_NOTIONAL_USD=250.0
# EXECUTION_EXIT_MAX_ORDERS_PER_RUN=6
# EXECUTION_READINESS_MAX_STALE_SUBMITTED_MINUTES=180
# EXECUTION_READINESS_MAX_UNMATCHED_OPEN_ORDERS=10
# EXECUTION_READINESS_MAX_POSITION_DRIFT_NOTIONAL_USD=2500.0
# EXECUTION_READINESS_MIN_BUYING_POWER_USD=1.0
# EXECUTION_OPEN_ORDERS_MAX_AGE_MINUTES=90
# EXECUTION_OPEN_ORDERS_REPLACE_STALE=false
# EXECUTION_OPEN_ORDERS_REPLACEMENT_ORDER_TYPE=market
# EXECUTION_OPEN_ORDERS_LIMIT_PRICE_OFFSET_BPS=10.0
# EXECUTION_OPEN_ORDERS_MAX_RETRIES_PER_SYMBOL_PER_DAY=2
# EXECUTION_SYNC_MANAGE_OPEN_ORDERS=false
# EXECUTION_SYNC_MANAGE_OPEN_ORDERS_APPLY=false
# EXECUTION_SYNC_SYNC_SHADOW_POSITIONS=false
# EXECUTION_SYNC_SYNC_SHADOW_POSITIONS_APPLY=false
# EXECUTION_SYNC_AUTO_REMEDIATE_READINESS=true
# EXECUTION_SYNC_AUTO_REMEDIATE_DROP_MISSING=true
# PAPER_POSITIONS_PATH=eval_results/paper_execution/positions.json
# PAPER_CLOSED_TRADES_PATH=eval_results/paper_execution/closed_trades.json
