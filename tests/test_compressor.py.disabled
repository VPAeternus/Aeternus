class TestFormatFundamentalKeyClaimsFunctions:
    """Test format_fundamental_key_claims() with full and empty metrics."""

    def test_format_fundamental_full_metrics_returns_non_empty_string(self):
        """format_fundamental_key_claims with full metrics dict → non-empty string."""
        metrics = _fundamental_metrics_full()
        result = format_fundamental_key_claims(metrics)

        assert isinstance(result, str)
        assert len(result) > 0
        assert "FUNDAMENTAL KEY CLAIMS" in result

    def test_format_fundamental_full_metrics_contains_key_fields(self):
        """format_fundamental_key_claims with full metrics → includes F-Score, ROE, valuation."""
        metrics = _fundamental_metrics_full()
        result = format_fundamental_key_claims(metrics)

        # Should include F-Score
        assert "F-Score" in result or "fscore" in result
        # Should include valuation or ROE
        assert "ROE" in result or "Valuation" in result or "P/E" in result

    def test_format_fundamental_empty_dict_returns_graceful_message(self):
        """format_fundamental_key_claims with empty dict → graceful fallback."""
        metrics = _fundamental_metrics_empty()
        result = format_fundamental_key_claims(metrics)

        assert isinstance(result, str)
        assert len(result) > 0
        assert "Insufficient data" in result or "FUNDAMENTAL" in result

    def test_format_fundamental_red_flag_weak_piotroski(self):
        """format_fundamental_key_claims detects weak Piotroski (fscore ≤ 3)."""
        metrics = _fundamental_metrics_red_flags()
        result = format_fundamental_key_claims(metrics)

        # fscore=2, should mention weakness
        assert "weak Piotroski" in result or "Red flags" in result

    def test_format_fundamental_red_flag_high_leverage(self):
        """format_fundamental_key_claims detects high leverage (D/E > 2.0)."""
        metrics = _fundamental_metrics_red_flags()
        result = format_fundamental_key_claims(metrics)

        # debt_to_equity=2.5, should flag
        assert "high leverage" in result or "Red flags" in result

    def test_format_fundamental_red_flag_weak_liquidity(self):
        """format_fundamental_key_claims detects weak liquidity (current_ratio < 1.0)."""
        metrics = _fundamental_metrics_red_flags()
        result = format_fundamental_key_claims(metrics)

        # current_ratio=0.85, should flag
        assert "weak liquidity" in result or "Red flags" in result

    def test_format_fundamental_good_metrics_no_red_flags(self):
        """format_fundamental_key_claims with clean metrics → reports no red flags."""
        metrics = _fundamental_metrics_full()
        result = format_fundamental_key_claims(metrics)

        # Should say there are no critical red flags
        assert "No critical red flags" in result or "not critical" in result or "clean" in result.lower()

    def test_format_fundamental_fcf_positive_vs_negative(self):
        """format_fundamental_key_claims shows FCF status (Positive/Negative)."""
        metrics_pos = _fundamental_metrics_full()
        result_pos = format_fundamental_key_claims(metrics_pos)
        assert "Positive" in result_pos

        metrics_neg = _fundamental_metrics_red_flags()
        result_neg = format_fundamental_key_claims(metrics_neg)
        assert "Negative" in result_neg


