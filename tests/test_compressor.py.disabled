# =============================================================================
# TestCompactness
# =============================================================================


class TestCompactness:
    """Test that all formatters produce compact, concise output."""

    def test_momentum_output_under_300_chars(self):
        """format_momentum_key_claims output ≤ 300 chars for typical input."""
        metrics = _momentum_metrics_full()
        result = format_momentum_key_claims(metrics)
        assert len(result) <= 300, f"Output too long: {len(result)} chars"

    def test_fundamental_output_under_300_chars(self):
        """format_fundamental_key_claims output ≤ 300 chars for typical input."""
        metrics = _fundamental_metrics_full()
        result = format_fundamental_key_claims(metrics)
        assert len(result) <= 300, f"Output too long: {len(result)} chars"

    def test_sentiment_output_under_300_chars(self):
        """format_sentiment_key_claims output ≤ 300 chars for typical input."""
        metrics = _sentiment_metrics_full()
        result = format_sentiment_key_claims(metrics)
        assert len(result) <= 300, f"Output too long: {len(result)} chars"

    def test_macro_output_under_300_chars(self):
        """format_macro_key_claims output ≤ 300 chars for typical input."""
        metrics = _macro_metrics_full()
        result = format_macro_key_claims(metrics)
        assert len(result) <= 300, f"Output too long: {len(result)} chars"

    def test_momentum_no_long_sentences(self):
        """format_momentum_key_claims lines ≤ 100 chars (bullet style)."""
        metrics = _momentum_metrics_full()
        result = format_momentum_key_claims(metrics)
        lines = result.split("\n")
        for line in lines:
            assert len(line) <= 110, f"Line too long ({len(line)} chars): {line}"

    def test_fundamental_no_long_sentences(self):
        """format_fundamental_key_claims lines ≤ 100 chars (bullet style)."""
        metrics = _fundamental_metrics_full()
        result = format_fundamental_key_claims(metrics)
        lines = result.split("\n")
        for line in lines:
            assert len(line) <= 110, f"Line too long ({len(line)} chars): {line}"

    def test_sentiment_no_long_sentences(self):
        """format_sentiment_key_claims lines ≤ 100 chars (bullet style)."""
        metrics = _sentiment_metrics_full()
        result = format_sentiment_key_claims(metrics)
        lines = result.split("\n")
        for line in lines:
            assert len(line) <= 110, f"Line too long ({len(line)} chars): {line}"

    def test_macro_no_long_sentences(self):
        """format_macro_key_claims lines ≤ 100 chars (bullet style)."""
        metrics = _macro_metrics_full()
        result = format_macro_key_claims(metrics)
        lines = result.split("\n")
        for line in lines:
            assert len(line) <= 110, f"Line too long ({len(line)} chars): {line}"


# =============================================================================
# TestKeyClaimsStateFields
# =============================================================================


class TestKeyClaimsStateFields:
    """Test that AgentState has all 4 key_claims fields with correct annotations."""

    def test_agent_state_has_momentum_key_claims_field(self):
        """AgentState TypedDict has momentum_key_claims field."""
        assert "momentum_key_claims" in AgentState.__annotations__

    def test_agent_state_has_fundamental_key_claims_field(self):
        """AgentState TypedDict has fundamental_key_claims field."""
        assert "fundamental_key_claims" in AgentState.__annotations__

    def test_agent_state_has_sentiment_key_claims_field(self):
        """AgentState TypedDict has sentiment_key_claims field."""
        assert "sentiment_key_claims" in AgentState.__annotations__

    def test_agent_state_has_macro_key_claims_field(self):
        """AgentState TypedDict has macro_key_claims field."""
        assert "macro_key_claims" in AgentState.__annotations__

    def test_all_key_claims_fields_are_string_type(self):
        """All 4 key_claims fields should be str type in annotations."""
        from typing import get_args, get_origin
        from typing_extensions import Annotated

        for field in [
            "momentum_key_claims",
            "fundamental_key_claims",
            "sentiment_key_claims",
            "macro_key_claims",
        ]:
            ann = AgentState.__annotations__[field]
            # Annotated[str, "..."] → get_origin is Annotated, get_args[0] is str
            if get_origin(ann) is Annotated:
                arg_type = get_args(ann)[0]
                assert arg_type is str, f"{field} is not str, got {arg_type}"


# =============================================================================
# TestDebateLlmConfig
# =============================================================================


class TestDebateLlmConfig:
    """Test S-031 model tiering config: debate_llm, debate_provider, debate_backend_url."""

    def test_default_config_has_debate_llm_key(self):
        """DEFAULT_CONFIG contains debate_llm key."""
        assert "debate_llm" in DEFAULT_CONFIG
        assert isinstance(DEFAULT_CONFIG["debate_llm"], str)
        assert len(DEFAULT_CONFIG["debate_llm"]) > 0

    def test_default_config_has_debate_provider_key(self):
        """DEFAULT_CONFIG contains debate_provider key."""
        assert "debate_provider" in DEFAULT_CONFIG
        assert isinstance(DEFAULT_CONFIG["debate_provider"], str)
        assert len(DEFAULT_CONFIG["debate_provider"]) > 0

    def test_default_config_has_debate_backend_url_key(self):
        """DEFAULT_CONFIG contains debate_backend_url key."""
        assert "debate_backend_url" in DEFAULT_CONFIG
        assert isinstance(DEFAULT_CONFIG["debate_backend_url"], str)
        assert len(DEFAULT_CONFIG["debate_backend_url"]) > 0

    def test_debate_llm_sensible_value(self):
        """debate_llm has a reasonable model name."""
        model = DEFAULT_CONFIG["debate_llm"]
        # Should be a known model identifier (Haiku, Sonnet, MiniMax, etc.)
        assert any(
            part.lower() in model.lower()
            for part in ["haiku", "sonnet", "opus", "minimax", "gpt", "claude"]
        ), f"Unexpected model name: {model}"

    def test_debate_provider_sensible_value(self):
        """debate_provider is a recognized LLM provider."""
        provider = DEFAULT_CONFIG["debate_provider"]
        valid_providers = [
            "openai",
            "anthropic",
            "minimax",
            "xai",
            "google",
            "ollama",
        ]
        assert provider.lower() in valid_providers, f"Unknown provider: {provider}"

    def test_debate_backend_url_is_url(self):
        """debate_backend_url looks like a valid URL."""
        url = DEFAULT_CONFIG["debate_backend_url"]
        assert url.startswith("http://") or url.startswith("https://"), f"Not a URL: {url}"

    def test_debate_config_env_var_overridable(self):
        """debate_llm is derived from env vars (can be overridden)."""
        import os

        # Check that the config keys reference env vars in their definitions
        # (This is a documentation test — verify the pattern exists)
        original_env = os.getenv("AETERNUS_DEBATE_MODEL")
        try:
            os.environ["AETERNUS_DEBATE_MODEL"] = "test-model-123"
            # Re-import to pick up new env var
            import importlib
            import tradingagents.default_config as cfg_module

            importlib.reload(cfg_module)
            assert cfg_module.DEFAULT_CONFIG["debate_llm"] == "test-model-123"
        finally:
            if original_env:
                os.environ["AETERNUS_DEBATE_MODEL"] = original_env
            else:
                os.environ.pop("AETERNUS_DEBATE_MODEL", None)
            importlib.reload(cfg_module)
