# =============================================================================
# TestFormatMomentumKeyClaimsFunctions
# =============================================================================


class TestFormatMomentumKeyClaimsFunctions:
    """Test format_momentum_key_claims() with full and empty metrics."""

    def test_format_momentum_full_metrics_returns_non_empty_string(self):
        """format_momentum_key_claims with full metrics dict → non-empty string."""
        metrics = _momentum_metrics_full()
        result = format_momentum_key_claims(metrics)

        assert isinstance(result, str)
        assert len(result) > 0
        assert "MOMENTUM KEY CLAIMS" in result

    def test_format_momentum_full_metrics_contains_key_fields(self):
        """format_momentum_key_claims with full metrics → includes trend_strength, direction, etc."""
        metrics = _momentum_metrics_full()
        result = format_momentum_key_claims(metrics)

        # Should include direction
        assert "BULLISH" in result
        # Should include key subscores
        assert "trend_strength" in result or "trend" in result

    def test_format_momentum_empty_dict_returns_graceful_message(self):
        """format_momentum_key_claims with empty dict → graceful fallback."""
        metrics = _momentum_metrics_empty()
        result = format_momentum_key_claims(metrics)

        assert isinstance(result, str)
        assert len(result) > 0
        # Should not raise, should return something sensible
        assert "Insufficient data" in result or "MOMENTUM" in result

    def test_format_momentum_red_flag_weak_regime_quality(self):
        """format_momentum_key_claims detects weak regime_quality (≤35) and mentions it."""
        metrics = _momentum_metrics_red_flags()
        result = format_momentum_key_claims(metrics)

        # regime_quality is 25, should flag weakness
        assert "Regime" in result or "choppy" in result or "weak" in result

    def test_format_momentum_red_flag_momentum_health_vs_trend_strength(self):
        """format_momentum_key_claims detects exhaustion (mh < 45 and ts > 55)."""
        metrics = _momentum_metrics_red_flags()
        result = format_momentum_key_claims(metrics)

        # momentum_health=40, trend_strength=72 → should mention exhaustion
        assert "exhaustion" in result or "declining" in result or "Watch" in result

    def test_format_momentum_low_volume_confirmation_flag(self):
        """format_momentum_key_claims flags low volume_confirmation (≤40)."""
        metrics = _momentum_metrics_red_flags()
        result = format_momentum_key_claims(metrics)

        # volume_confirmation=35, should flag
        assert "NOT confirming" in result or "suspect" in result or "vol" in result

    def test_format_momentum_strong_regime_quality_flag(self):
        """format_momentum_key_claims notes strong regime_quality (≥65)."""
        metrics = _momentum_metrics_full()
        result = format_momentum_key_claims(metrics)

        # regime_quality=75, should note strength
        assert "strong" in result and "persistent" in result


