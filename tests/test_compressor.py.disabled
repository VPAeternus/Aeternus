class TestFormatSentimentKeyClaimsFunctions:
    """Test format_sentiment_key_claims() with full and empty metrics."""

    def test_format_sentiment_full_metrics_returns_non_empty_string(self):
        """format_sentiment_key_claims with full metrics dict → non-empty string."""
        metrics = _sentiment_metrics_full()
        result = format_sentiment_key_claims(metrics)

        assert isinstance(result, str)
        assert len(result) > 0
        assert "SENTIMENT KEY CLAIMS" in result

    def test_format_sentiment_full_metrics_contains_key_fields(self):
        """format_sentiment_key_claims with full metrics → includes composite, articles, direction."""
        metrics = _sentiment_metrics_full()
        result = format_sentiment_key_claims(metrics)

        # Should include direction
        assert "BULLISH" in result
        # Should include article count
        assert "24" in result or "articles" in result or "coverage" in result

    def test_format_sentiment_empty_dict_returns_graceful_message(self):
        """format_sentiment_key_claims with empty dict → graceful fallback."""
        metrics = _sentiment_metrics_empty()
        result = format_sentiment_key_claims(metrics)

        assert isinstance(result, str)
        assert len(result) > 0
        assert "Insufficient data" in result or "SENTIMENT" in result

    def test_format_sentiment_red_flag_divergence(self):
        """format_sentiment_key_claims detects divergence (|AV - social| > 30)."""
        metrics = _sentiment_metrics_red_flags()
        result = format_sentiment_key_claims(metrics)

        # av_sentiment.score=0.45 (45%), text_sentiment.social_score=78 → large gap
        assert "DIVERGENCE" in result or "disagree" in result or "sources" in result

    def test_format_sentiment_sources_aligned(self):
        """format_sentiment_key_claims reports alignment when sources agree."""
        metrics = _sentiment_metrics_full()
        result = format_sentiment_key_claims(metrics)

        # av_sentiment.score=0.65 (65%), text_sentiment.social_score=62 → close
        assert "aligned" in result or "Sources" in result

    def test_format_sentiment_red_flag_low_buzz(self):
        """format_sentiment_key_claims detects low buzz (total_articles ≤ 3)."""
        metrics = _sentiment_metrics_red_flags()
        result = format_sentiment_key_claims(metrics)

        # total_articles=2, should flag
        assert "low" in result.lower() and ("buzz" in result or "coverage" in result or "unreliable" in result)

    def test_format_sentiment_elevated_buzz(self):
        """format_sentiment_key_claims notes elevated buzz (total_articles ≥ 15)."""
        metrics = _sentiment_metrics_full()
        result = format_sentiment_key_claims(metrics)

        # total_articles=24, should note
        assert "elevated" in result or "Buzz" in result


